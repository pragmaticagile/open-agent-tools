JIRA_BASE_URL=https://YOUR_JIRA_SITE_NAME.atlassian.net
JIRA_EMAIL=YOUR_EMAIL_HERE
JIRA_API_TOKEN=YOUR_API_TOKEN_HERE

# Alternative to JIRA_API_TOKEN:
# JIRA_API_TOKEN_FILE=/path/to/token-file

# Optional convenience defaults. Leave these commented unless you want shortcuts.
# JIRA_DEFAULT_PROJECT=YOUR_PROJECT_KEY_HERE
# JIRA_DEFAULT_BOARD=YOUR_BOARD_ID_HERE
# JIRA_DEFAULT_SPRINT=YOUR_SPRINT_ID_HERE
# JIRA_TIMEZONE=UTC

# Read-only by default. Set to true only when you want tools that modify Jira.
JIRA_ENABLE_WRITE_TOOLS=false

# This package currently does not register delete tools. Reserved for future explicit opt-in.
JIRA_ENABLE_DANGEROUS_TOOLS=false
