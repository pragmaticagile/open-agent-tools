AZURE_DEVOPS_ORG=YOUR_ORGANIZATION_NAME_HERE
AZURE_DEVOPS_PAT_FILE=/FULL/PATH/TO/.codex/ado-plus-pat.txt

# Alternative to AZURE_DEVOPS_PAT_FILE:
# AZURE_DEVOPS_PAT=YOUR_PAT_HERE

# Optional convenience defaults. Tools can also receive these values as inputs.
AZURE_DEVOPS_DEFAULT_PROJECT=YOUR_PROJECT_NAME_HERE
AZURE_DEVOPS_DEFAULT_TEAM=YOUR_TEAM_NAME_HERE
AZURE_DEVOPS_DEFAULT_REPOSITORY=YOUR_REPOSITORY_NAME_HERE
AZURE_DEVOPS_DEFAULT_DELIVERY_PLAN=YOUR_DELIVERY_PLAN_NAME_HERE
AZURE_DEVOPS_DEFAULT_PIPELINE=YOUR_PIPELINE_ID_HERE
ADO_PLUS_TIMEZONE=UTC
